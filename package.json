{
    "name": "starter-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "set BACKEND_PORT=5001 && node server/index.js & vite",
        "build": "tsc -b && vite build",
        "eslint": "eslint . --ext .ts,.tsx --fix --max-warnings 0",
        "preview": "vite preview",
        "prettier": "prettier . --write --ignore-unknown",
        "serve:dist": "serve -s dist -p 5000",
        "server:start": "BACKEND_PORT=5000 node server/index.js"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "firebase": "^12.13.0",
        "lucide-react": "^0.562.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "socket.io": "^4.8.3",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@tailwindcss/vite": "^4.1.18",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "eslint": "^9.25.0",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^16.0.0",
        "prettier": "^3.5.3",
        "socket.io-client": "^4.8.3",
        "tailwindcss": "^4.1.18",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "npm:rolldown-vite@7.2.5"
    },
    "pnpm": {
        "overrides": {
            "vite": "npm:rolldown-vite@7.2.5"
        }
    }
}
